# Copy to .env locally; never commit .env.
OPENAI_BASE_URL=https://your-api-endpoint/v1
OPENAI_API_KEY=replace-me
OPENAI_MODEL=gpt-4o

# Authorized controlled-access data and evaluator tools
HIRETEST_DATA_ROOT=/path/to/authorized/hiretest-data
HIRETEST_DERIVED_DATA_ROOT=/path/to/authorized/hiretest-derived-data
HIRETEST_REPAIR_PROMPT_ROOT=/path/to/authorized/history-guided-prompts
HIRETEST_MARS_JAR=/path/to/MARS.jar
HIRETEST_LLI=/path/to/llvm-12.0.0/bin/lli
HIRETEST_RUNTIME_LL=/path/to/runtime.ll

# Pseudonymous reference IDs assigned inside the controlled data package
HIRETEST_REFERENCE_IDS_FRONTEND=ref-a,ref-b,ref-c
HIRETEST_REFERENCE_IDS_STAGE4=ref-d,ref-e,ref-f
HIRETEST_REFERENCE_IDS_STAGE5=ref-g,ref-h,ref-i
